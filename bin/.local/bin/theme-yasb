#!/usr/bin/env python3
"""Swap the Catppuccin palette in YASB's styles.css. Called by `theme`.

    theme-yasb dark|light

styles.css keeps every colour as a variable in its first `:root { ... }` block
(`--base: #1e1e2e;` and so on), and the rest of the file only uses `var(--base)`.
So switching flavour means rewriting just those variable values. YASB has
`watch_stylesheet: true`, so it restyles the bar as soon as the file changes.
"""

import re
import sys
from pathlib import Path

STYLESHEET = Path("/mnt/c/Users/catri/.config/yasb/styles.css")

PALETTES = {
    "dark": {
        "name": "Catppuccin Mocha",
        "rosewater": "#f5e0dc",
        "flamingo": "#f2cdcd",
        "pink": "#f5c2e7",
        "mauve": "#cba6f7",
        "red": "#f38ba8",
        "maroon": "#eba0ac",
        "peach": "#fab387",
        "yellow": "#f9e2af",
        "green": "#a6e3a1",
        "teal": "#94e2d5",
        "sky": "#89dceb",
        "sapphire": "#74c7ec",
        "blue": "#89b4fa",
        "lavender": "#b4befe",
        "text": "#cdd6f4",
        "subtext1": "#bac2de",
        "subtext0": "#a6adc8",
        "overlay2": "#9399b2",
        "overlay1": "#7f849c",
        "overlay0": "#6c7086",
        "surface2": "#585b70",
        "surface1": "#45475a",
        "surface0": "#313244",
        "base": "#1e1e2e",
        "mantle": "#181825",
        "crust": "#11111b",
        "bar-bg": "rgba(17, 17, 27, 0.5)",
    },
    "light": {
        "name": "Catppuccin Latte",
        "rosewater": "#dc8a78",
        "flamingo": "#dd7878",
        "pink": "#ea76cb",
        "mauve": "#8839ef",
        "red": "#d20f39",
        "maroon": "#e64553",
        "peach": "#fe640b",
        "yellow": "#df8e1d",
        "green": "#40a02b",
        "teal": "#179299",
        "sky": "#04a5e5",
        "sapphire": "#209fb5",
        "blue": "#1e66f5",
        "lavender": "#7287fd",
        "text": "#4c4f69",
        "subtext1": "#5c5f77",
        "subtext0": "#6c6f85",
        "overlay2": "#7c7f93",
        "overlay1": "#8c8fa1",
        "overlay0": "#9ca0b0",
        "surface2": "#acb0be",
        "surface1": "#bcc0cc",
        "surface0": "#ccd0da",
        "base": "#eff1f5",
        "mantle": "#e6e9ef",
        "crust": "#dce0e8",
        # More solid than mocha's: dark text over a see-through light bar is
        # hard to read (same reason the terminal goes to 95% opacity).
        "bar-bg": "rgba(220, 224, 232, 0.85)",
    },
}


def main() -> None:
    if len(sys.argv) != 2 or sys.argv[1] not in PALETTES:
        sys.exit("usage: theme-yasb dark|light")
    palette = PALETTES[sys.argv[1]]

    # newline="" keeps the file's Windows (CRLF) line endings as they are;
    # by default Python would convert every line to LF on the way through.
    with STYLESHEET.open(encoding="utf-8", newline="") as f:
        css = f.read()

    root = re.search(r":root\s*\{.*?\}", css, re.DOTALL)
    if root is None:
        sys.exit(f"theme-yasb: no :root block in {STYLESHEET}")
    block = root.group(0)

    # `--base: #1e1e2e;`  ->  `--base: #eff1f5;`  (only for names we know)
    def swap(match: re.Match) -> str:
        name = match.group(2)
        if name not in palette:
            return match.group(0)
        return f"{match.group(1)}{palette[name]};"

    block = re.sub(r"(--([\w-]+):\s*)[^;]+;", swap, block)
    block = re.sub(r"Catppuccin \w+ color palette", f"{palette['name']} color palette", block)

    new_css = css[: root.start()] + block + css[root.end() :]
    if new_css != css:
        with STYLESHEET.open("w", encoding="utf-8", newline="") as f:
            f.write(new_css)


if __name__ == "__main__":
    main()
